# Copy to deploy/.env and source it before start.sh:  set -a; . deploy/.env; set +a
# (start.sh reads these from the environment.)

# REQUIRED for a public deploy. Generate with: openssl rand -hex 32
API_KEY=change-me

# CORS — lock to the FE origin if the browser calls the API directly. "*" is fine
# for server-to-server calls (CORS doesn't apply there).
ALLOWED_ORIGINS=*

# Model (must match what the app/benchmark validated).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Stable public hostname: create a Named Tunnel in Cloudflare Zero Trust
# (Networks -> Tunnels), route its public hostname to http://localhost:8000,
# then paste the tunnel token here. Leave EMPTY to get a random trycloudflare URL.
CLOUDFLARE_TUNNEL_TOKEN=

# Endpoint = RunPod proxy (expose port 8000 on the pod). cloudflared stays OFF.
# Flip to "true" + set CLOUDFLARE_TUNNEL_TOKEN later if you want a stable hostname.
ENABLE_TUNNEL=false

# Point Ollama's model store at a persistent volume so the 4.7GB model survives
# pod recreate (RunPod network volumes usually mount at /workspace).
# OLLAMA_MODELS=/workspace/.ollama/models

# --- FE result callback (fire-and-forget postback when a job completes) --------
# When a job finishes (success OR failure) the worker POSTs the full result to
# CALLBACK_URL. Failures are logged and swallowed (never break the job).
# Leave CALLBACK_URL empty to DISABLE the callback entirely. Set it to your FE
# endpoint to enable postback, e.g.:
CALLBACK_URL=https://your-fe.example/api/callback/ai
# Optional shared secret sent as the `X-Callback-Token` header so the FE can
# verify the sender. Empty = header not sent.
CALLBACK_TOKEN=
# Per-request timeout (seconds).
CALLBACK_TIMEOUT_S=10
